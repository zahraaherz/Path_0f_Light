rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // User avatars - authenticated users can upload their own, anyone can read
    match /users/{userId}/avatar/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024  // 5MB max
        && request.resource.contentType.matches('image/.*');
    }

    // User profile images
    match /users/{userId}/images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024  // 10MB max
        && request.resource.contentType.matches('image/.*');
    }

    // Audio files for prayers/duas (user uploads)
    match /users/{userId}/audio/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024  // 50MB max
        && request.resource.contentType.matches('audio/.*');
    }

    // Public content (books, images, audio) - read by all, write by admins only
    match /content/{type}/{fileName} {
      allow read: if true;
      // Write access controlled via Cloud Functions with admin role check
      allow write: if false;
    }

    // Book PDFs - read by authenticated users, write by admins via Cloud Functions
    match /books/{bookId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;  // Only via Cloud Functions
    }

    // Deny all other paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
