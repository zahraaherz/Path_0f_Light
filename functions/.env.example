# Firebase Cloud Functions Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ===== Email Service Configuration =====
# SMTP settings for sending authentication emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM_NAME=Path of Light
EMAIL_FROM_ADDRESS=noreply@pathoflight.app

# ===== RevenueCat Configuration =====
# Webhook secret for verifying RevenueCat webhook requests
# Get this from RevenueCat dashboard > Settings > Webhooks
REVENUECAT_WEBHOOK_SECRET=your-webhook-secret-here

# RevenueCat API Keys (also configured in Flutter app)
REVENUECAT_API_KEY_IOS=appl_YOUR_IOS_API_KEY
REVENUECAT_API_KEY_ANDROID=goog_YOUR_ANDROID_API_KEY

# ===== Firebase Configuration =====
# Your Firebase project ID
FIREBASE_PROJECT_ID=your-project-id

# Firebase Admin SDK service account (for local development)
# Download from Firebase Console > Project Settings > Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ===== Security Configuration =====
# Admin user IDs (comma-separated list for initial setup)
# After setup, use Firebase custom claims for admin access
ADMIN_USER_IDS=uid1,uid2,uid3

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://yourapp.com,https://admin.yourapp.com

# ===== Rate Limiting Configuration =====
# Maximum requests per minute for different endpoints
RATE_LIMIT_STANDARD=20
RATE_LIMIT_STRICT=5
RATE_LIMIT_QUIZ=10
RATE_LIMIT_AUTH=3

# ===== External Services =====
# Add any third-party API keys here
# EXAMPLE_API_KEY=your-api-key

# ===== Development/Production Toggle =====
# Set to 'production' or 'development'
NODE_ENV=development

# ===== Logging Configuration =====
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable structured logging (true/false)
STRUCTURED_LOGGING=true
