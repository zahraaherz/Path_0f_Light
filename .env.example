# Path of Light - Flutter App Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ===== RevenueCat Configuration =====
# Get these from RevenueCat dashboard > Settings > API Keys
# iOS API Key (starts with appl_)
REVENUECAT_API_KEY_IOS=appl_YOUR_IOS_API_KEY

# Android API Key (starts with goog_)
REVENUECAT_API_KEY_ANDROID=goog_YOUR_ANDROID_API_KEY

# ===== AdMob Configuration =====
# Get these from AdMob console > Apps
# iOS App ID
ADMOB_APP_ID_IOS=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY

# Android App ID
ADMOB_APP_ID_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY

# Banner Ad Unit IDs
ADMOB_BANNER_UNIT_ID_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
ADMOB_BANNER_UNIT_ID_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY

# Interstitial Ad Unit IDs
ADMOB_INTERSTITIAL_UNIT_ID_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
ADMOB_INTERSTITIAL_UNIT_ID_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY

# Rewarded Ad Unit IDs
ADMOB_REWARDED_UNIT_ID_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
ADMOB_REWARDED_UNIT_ID_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY

# ===== Environment Configuration =====
# Set to 'development' or 'production'
# In development, test ads and debug features are enabled
ENVIRONMENT=development

# Enable/disable features
ENABLE_ADS=true
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true

# ===== API Configuration =====
# If you have any external API endpoints
# API_BASE_URL=https://api.pathoflight.app

# ===== Feature Flags =====
# Enable/disable specific features for testing
FEATURE_BATTLE_MODE=true
FEATURE_TOURNAMENTS=true
FEATURE_SOCIAL_SHARING=true
